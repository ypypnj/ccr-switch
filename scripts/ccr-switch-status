#!/usr/bin/env bash
set -euo pipefail
INSTALL_DIR="${CCR_SWITCH_INSTALL_DIR:-$HOME/.local/share/ccr-switch}"
CONFIG_FILE="$HOME/.config/ccr-switch/config.json"
PORT="${CCR_SWITCH_PORT:-3456}"
if [[ "${CCR_SWITCH_USE_SYSTEMD:-0}" == 1 ]]; then
  systemctl --user is-active ccr-switch.service
else
  curl -fsS --max-time 2 "http://127.0.0.1:$PORT/health" >/dev/null && printf '[INFO] ccr-switch 健康\n' || {
    printf '[WARN] ccr-switch 不可用（安装目录：%s，配置：%s）\n' "$INSTALL_DIR" "$CONFIG_FILE" >&2
    exit 1
  }
fi
