#!/usr/bin/env bash
#
# ccr-switch-status — 查看 ccr-switch 代理运行状态
#
# 用法:
#   ccr-switch-status           # 人类可读输出
#   ccr-switch-status --json    # JSON 格式(供脚本消费)
#
# 检查项:
#   - proxy.js 进程是否存活(PID + 端口 3456)
#   - systemd 单元是否 active
#   - /health 端点是否响应
#   - 当前 .bashrc managed 块指向的模型
#

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

JSON_MODE=false
if [[ "${1:-}" == "--json" ]]; then
  JSON_MODE=true
fi

# ── 探针 ────────────────────────────────────────────────────────────────────
PROXY_PID=$(pgrep -f "node.*proxy.js.*3456" | head -1 || true)
SYSTEMD_ACTIVE=$(systemctl is-active ccr-switch 2>/dev/null || echo "unknown")
HEALTH=$(curl -sf -m 2 http://127.0.0.1:3456/health 2>/dev/null || echo "")
BASHRC_MODEL=$(awk '/^# 当前模式:/ {sub(/^# 当前模式: /, ""); print; exit}' ~/.bashrc 2>/dev/null || echo "")

# ── 输出 ────────────────────────────────────────────────────────────────────
if [[ "$JSON_MODE" == "true" ]]; then
  cat <<EOF
{
  "proxy_pid": "${PROXY_PID:-null}",
  "systemd": "${SYSTEMD_ACTIVE}",
  "health": $([ -n "$HEALTH" ] && echo '"ok"' || echo '"down"'),
  "bashrc_mode": "${BASHRC_MODEL}"
}
EOF
  exit 0
fi

# 人类可读
echo -e "${CYAN}ccr-switch 状态报告${NC}"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [[ -n "$PROXY_PID" ]]; then
  echo -e "  进程:    ${GREEN}运行中${NC} (PID ${PROXY_PID})"
else
  echo -e "  进程:    ${RED}未运行${NC}"
fi

case "$SYSTEMD_ACTIVE" in
  active)   echo -e "  systemd: ${GREEN}active${NC}" ;;
  inactive) echo -e "  systemd: ${YELLOW}inactive${NC}" ;;
  *)        echo -e "  systemd: ${YELLOW}${SYSTEMD_ACTIVE}${NC}" ;;
esac

if [[ -n "$HEALTH" ]]; then
  echo -e "  健康:    ${GREEN}OK${NC} (/health 响应 200)"
else
  echo -e "  健康:    ${RED}DOWN${NC} (/health 无响应)"
fi

if [[ -n "$BASHRC_MODEL" ]]; then
  echo -e "  模式:    ${BASHRC_MODEL}"
fi
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
