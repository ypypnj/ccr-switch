[Unit]
Description=CCR Switch 多 Provider 模型代理
After=network.target

[Service]
Type=simple
WorkingDirectory=@INSTALL_DIR@
ExecStart=/usr/bin/node @INSTALL_DIR@/proxy.js --config @HOME@/.config/ccr-switch/config.json --port 3456
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@HOME@/.config/ccr-switch

[Install]
WantedBy=default.target
