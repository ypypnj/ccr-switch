#!/usr/bin/env bash
set -euo pipefail
INSTALL_DIR="${CCR_SWITCH_INSTALL_DIR:-$HOME/.local/share/ccr-switch}"
CONFIG_FILE="$HOME/.config/ccr-switch/config.json"
PORT="${CCR_SWITCH_PORT:-3456}"
PID_FILE="$HOME/.config/ccr-switch/proxy.pid"

fail(){ printf '[ERROR] %s\n' "$*" >&2; exit 1; }

# ── 祖先路径验证：$HOME、$HOME/.config、$HOME/.config/ccr-switch、install dir 每级不得为 symlink，且属当前用户 ──
validate_ancestors(){
  local target="$1"
  node - "$target" <<'NODE' || fail "路径祖先链非法(symlink/owner 不匹配): $target"
const fs=require('fs'),path=require('path'),uid=process.getuid(),target=process.argv[2];
let cur=path.parse(path.resolve(target)).root;
for(const part of path.resolve(target).slice(cur.length).split(path.sep).filter(Boolean)){
  cur=path.join(cur,part);
  try{const s=fs.lstatSync(cur);if(s.isSymbolicLink()||s.uid!==uid)process.exit(1)}catch(e){if(e.code==='ENOENT')break;throw e}
}
NODE
}
validate_ancestors "$HOME"
validate_ancestors "$(dirname "$PID_FILE")"
validate_ancestors "$INSTALL_DIR"

# ── systemd 用户模式 ──
if [[ "${CCR_SWITCH_USE_SYSTEMD:-0}" == 1 ]]; then
  systemctl --user stop ccr-switch.service
  printf '[INFO] ccr-switch 已通过 systemd 停止\n'
  exit 0
fi

# ── nohup 模式：路径边界验证 ──
# 验证 PID 文件不可是 symlink/FIFO
if [[ -e "$PID_FILE" ]]; then
  [[ ! -L "$PID_FILE" ]] || fail "PID 文件不能是 symlink"
  [[ -f "$PID_FILE" ]] || fail "PID 文件不是普通文件"
  chmod 600 "$PID_FILE" 2>/dev/null || fail "无法设置 PID 文件权限"
fi

# 验证 PID 父目录不可是 symlink
pid_parent="$(dirname "$PID_FILE")"
if [[ -e "$pid_parent" ]]; then
  [[ ! -L "$pid_parent" ]] || fail "PID 父目录不能是 symlink"
  [[ -d "$pid_parent" ]] || fail "PID 父路径不是目录"
fi

# PID 文件不存在 → 无需停止
[[ -f "$PID_FILE" ]] || { printf '[INFO] ccr-switch 未运行(PID 文件不存在)\n'; exit 0; }

# 读取 PID 身份
pid=''; start=''; read -r pid start <"$PID_FILE" 2>/dev/null || true
[[ "$pid" =~ ^[0-9]+$ ]] || fail "PID 文件内容非法: '$pid'"

proc_starttime(){
  [[ "$1" =~ ^[0-9]+$ && -r "/proc/$1/stat" ]] || return 1
  node -e 'const s=require("fs").readFileSync(process.argv[1],"utf8"),i=s.lastIndexOf(") "),f=s.slice(i+2).split(" ");process.stdout.write(f[19]||"")' "/proc/$1/stat"
}

# 验证进程仍在运行
if ! kill -0 "$pid" 2>/dev/null; then
  printf '[INFO] PID=%s 已不在运行，清理 stale PID 文件\n' "$pid"
  rm -f "$PID_FILE"
  exit 0
fi

# 验证进程 owner 是当前用户
[[ "$(stat -c '%u' "/proc/$pid" 2>/dev/null || echo 0)" == "$(id -u)" ]] || fail "PID=$pid 不属于当前用户，拒绝操作"

# 验证 cmdline 匹配
cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
expected="node $INSTALL_DIR/proxy.js --config $CONFIG_FILE --port $PORT"
[[ "$cmd" == *"$expected"* ]] || fail "PID=$pid cmdline 不匹配代理进程，拒绝停止"

# 验证 start-time 匹配（如果 PID 文件含 start-time）
if [[ -n "$start" && "$start" =~ ^[0-9]+$ ]]; then
  current_start="$(proc_starttime "$pid" 2>/dev/null || true)"
  if [[ -n "$current_start" ]]; then
    [[ "$current_start" == "$start" ]] || fail "PID=$pid start-time 不匹配(PID 文件=$start, 实际=$current_start)，PID 可能被复用，拒绝停止"
  fi
fi

# 停止进程（绝不使用进程名匹配或端口扫描）
kill -TERM "$pid" 2>/dev/null || true
waited=0
while kill -0 "$pid" 2>/dev/null; do
  sleep 0.1; waited=$((waited+1))
  if [[ $waited -gt 50 ]]; then
    kill -KILL "$pid" 2>/dev/null || true
    break
  fi
done
waited=0
while kill -0 "$pid" 2>/dev/null; do sleep 0.1; waited=$((waited+1)); [[ $waited -le 20 ]] || break; done

rm -f "$PID_FILE"
printf '[INFO] ccr-switch 已停止 (PID=%s)\n' "$pid"
