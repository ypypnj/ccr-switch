#!/usr/bin/env bash
#
# ccr-switch-off — 关闭 ccr-switch 代理,改 .bashrc 切到直连大模型
#
# 用法:
#   ccr-switch-off           交互式菜单(1/2/3/C)
#   ccr-switch-off ds        直连 DeepSeek V4 Pro (短别名)
#   ccr-switch-off mm        直连 MiniMax M3
#   ccr-switch-off bd        直连 Baidu Qianfan GLM-5.1
#   ccr-switch-off custom    交互输入 base_url / api_key / model
#
# 副作用:
#   1. 改写 ~/.bashrc 中 managed 块(awk 替换,严格幂等)
#   2. 杀掉 3456 端口上运行的 proxy.js
#   3. 提示重启 Claude Code session
#
# 安全:
#   - 不在脚本中硬编码任何 API key
#   - 所有 key 从 ~/.claude/dev-flow/credentials.json (chmod 600) 读取
#   - 当前会话实时从 .bashrc 块中提取的 key 不持久化到磁盘(只在 stdout 输出)
#

set -euo pipefail

# ── Colours ────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}[INFO]${NC}  $*"; }
ok()    { echo -e "${GREEN}[OK]${NC}    $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC}  $*"; }
err()   { echo -e "${RED}[ERROR]${NC} $*"; }

# ── 自定位:从 /usr/local/bin/ccr-switch-off 反推仓库根 ──────────────────────
SCRIPT_REAL="$(readlink -f "$0")"
# 兼容 install -m 755 直接复制和未来软链两种模式
REPO_ROOT="$(cd "$(dirname "$SCRIPT_REAL")/.." 2>/dev/null && pwd || true)"
# 如果脚本在 /usr/local/bin,REPO_ROOT 找 ccr-switch 的标准路径
if [[ ! -f "${REPO_ROOT}/presets.json" && -f "/root/ese-project/ccr-switch/presets.json" ]]; then
  REPO_ROOT="/root/ese-project/ccr-switch"
fi

PRESETS_FILE="${REPO_ROOT}/presets.json"
CREDS_FILE="${HOME}/.claude/dev-flow/credentials.json"
BASHRC="${HOME}/.bashrc"

MARKER_BEGIN="# >>> ccr-switch managed block (do not edit) >>>"
MARKER_END="# <<< ccr-switch managed block <<<"

# ── 预检 ────────────────────────────────────────────────────────────────────
if [[ ! -f "${PRESETS_FILE}" ]]; then
  err "未找到 ${PRESETS_FILE}"
  err "请先运行 ccr-switch 安装脚本: bash ${REPO_ROOT}/install.sh"
  exit 1
fi
if ! command -v jq >/dev/null 2>&1; then
  err "缺少 jq 工具,无法解析 presets.json"
  exit 1
fi

# ── 读 credentials ──────────────────────────────────────────────────────────
declare -A CREDS
if [[ -f "${CREDS_FILE}" ]]; then
  while IFS="=" read -r k v; do
    CREDS["$k"]="$v"
  done < <(jq -r 'to_entries | .[] | "\(.key)=\(.value)"' "${CREDS_FILE}" 2>/dev/null || true)
fi

# ── 列出可用预设 ────────────────────────────────────────────────────────────
list_presets() {
  echo ""
  echo "  可用直连预设:"
  jq -r '.presets[] | "    [\(.id)] \(.alias) → \(.label)"' "${PRESETS_FILE}"
  echo "    [C] 自定义(交互输入 base_url / api_key / model)"
  echo ""
}

# ── 拼装一个 preset 的环境变量块(直连模式) ────────────────────────────────
build_direct_block() {
  local id="$1"
  local preset_json
  preset_json=$(jq -c --arg id "$id" '.presets[] | select(.id == $id)' "${PRESETS_FILE}")
  if [[ -z "$preset_json" || "$preset_json" == "null" ]]; then
    err "未找到 id='$id' 的预设"
    return 1
  fi

  local label alias base_url model token
  label=$(echo "$preset_json" | jq -r '.label')
  alias=$(echo "$preset_json" | jq -r '.alias')
  base_url=$(echo "$preset_json" | jq -r '.env.ANTHROPIC_BASE_URL')
  model=$(echo "$preset_json" | jq -r '.env.ANTHROPIC_MODEL')

  # 从 placeholder <DS_KEY>/<MM_KEY>/<BD_KEY> 映射到 credentials.json 里的真 key
  token=$(echo "$preset_json" | jq -r '.env.ANTHROPIC_AUTH_TOKEN')
  case "$token" in
    "<DS_KEY>") token="${CREDS[ds_key]:-}" ;;
    "<MM_KEY>") token="${CREDS[mm_key]:-}" ;;
    "<BD_KEY>") token="${CREDS[bd_key]:-}" ;;
  esac

  if [[ -z "$token" ]]; then
    err "凭据缺失:preset '$id' 需要 ${id}_key,但 ~/.claude/dev-flow/credentials.json 中没有"
    err "请运行: bash ${REPO_ROOT}/install.sh 重新配置"
    return 1
  fi

  # 块内容(由 awk 写入 .bashrc)
  cat <<EOF
${MARKER_BEGIN}
# 当前模式: 直连 — $alias ($label)
export ANTHROPIC_BASE_URL="${base_url}"
export ANTHROPIC_AUTH_TOKEN="${token}"
export ANTHROPIC_MODEL="${model}"
EOF

  # 透传 preset 中其它 ANTHROPIC_* 字段(OPUS/SONNET/HAIKU/SUBAGENT/EFFORT 等)
  echo "$preset_json" | jq -r '.env | to_entries[] | select(.key | startswith("ANTHROPIC_") or startswith("CLAUDE_CODE_")) | select(.key as $k | ["ANTHROPIC_BASE_URL","ANTHROPIC_AUTH_TOKEN","ANTHROPIC_MODEL"] | index($k) | not) | "export \(.key)=\(.value | tostring)"'

  cat <<EOF
${MARKER_END}
EOF
}

# ── 拼装自定义块 ────────────────────────────────────────────────────────────
build_custom_block() {
  echo ""
  echo "  自定义直连模式"
  echo "  (URL 必须以 http:// 或 https:// 开头)"
  echo ""

  local base_url api_key model
  while true; do
    read -r -p "  base_url: " base_url
    if [[ "$base_url" =~ ^https?:// ]]; then break; fi
    warn "URL 格式错误,必须以 http:// 或 https:// 开头"
  done
  while true; do
    read -r -s -p "  api_key: " api_key
    echo ""
    if [[ -n "$api_key" ]]; then break; fi
    warn "api_key 不能为空"
  done
  while true; do
    read -r -p "  model(上游模型名): " model
    if [[ -n "$model" ]]; then break; fi
    warn "model 不能为空"
  done

  cat <<EOF
${MARKER_BEGIN}
# 当前模式: 直连(自定义) — ${base_url} @ ${model}
export ANTHROPIC_BASE_URL="${base_url}"
export ANTHROPIC_AUTH_TOKEN="${api_key}"
export ANTHROPIC_MODEL="${model}"
${MARKER_END}
EOF
}

# ── 写 .bashrc managed 块(awk,严格幂等) ───────────────────────────────────
write_bashrc_block() {
  local block_content="$1"
  local tmp
  tmp=$(mktemp)

  # awk 行为:扫描每一行
  #   - 看到 begin marker → 输出新 block,设置 skip=1
  #   - skip=1 时跳过(end marker 除外)
  #   - 看到 end marker → 结束 skip
  #   - 否则正常输出
  # 效果:无论原文件有几个 marker 块,最后只剩一个新块
  printf '%s\n' "$block_content" | awk -v begin="$MARKER_BEGIN" -v end="$MARKER_END" '
    BEGIN { skip = 0; block_done = 0 }
    {
      if ($0 == begin) {
        if (!block_done) {
          # 读 stdin 输入的新块
          while ((getline line < "/dev/stdin") > 0) print line
          block_done = 1
        }
        skip = 1
        next
      }
      if ($0 == end) {
        skip = 0
        next
      }
      if (!skip) print
    }
  ' "$BASHRC" > "$tmp"

  # awk 内部读 stdin 的写法在不同 mawk/gawk 上行为不一致,这里改用更可靠的两步法:
  # 1. 先删除旧 managed 块(若有)
  # 2. 再 append 新块到文件末尾
  rm -f "$tmp"
  tmp=$(mktemp)
  awk -v begin="$MARKER_BEGIN" -v end="$MARKER_END" '
    BEGIN { skip = 0 }
    $0 == begin { skip = 1; next }
    $0 == end   { skip = 0; next }
    !skip { print }
  ' "$BASHRC" > "$tmp"

  # 如果原文件以换行结尾(应该),append 前不需额外换行;否则补一个
  if [[ -s "$tmp" ]] && [[ "$(tail -c 1 "$tmp")" != $'\n' ]]; then
    echo "" >> "$tmp"
  fi
  echo "" >> "$tmp"
  echo "$block_content" >> "$tmp"

  mv "$tmp" "$BASHRC"
  ok ".bashrc managed 块已更新"
}

# ── 杀代理进程 ──────────────────────────────────────────────────────────────
kill_proxy() {
  local killed=0
  if pgrep -f "node.*proxy.js.*3456" >/dev/null 2>&1; then
    info "停止 ccr-switch 代理(端口 3456)..."
    fuser -k 3456/tcp 2>/dev/null || true
    sleep 1
    killed=1
  fi
  # 兜底:ccr cli 进程
  if pgrep -f "claude-code-router" >/dev/null 2>&1; then
    ccr stop 2>/dev/null || true
    killed=1
  fi
  if [[ $killed -eq 1 ]]; then
    ok "ccr-switch 代理已关闭"
  else
    info "ccr-switch 代理未运行,无需停止"
  fi
}

# ── 提示运行中的 claude session ─────────────────────────────────────────────
warn_running_claude() {
  local pids
  pids=$(pgrep -f "claude" 2>/dev/null | grep -v "$$" | head -5 || true)
  if [[ -n "$pids" ]]; then
    warn "检测到运行中的 claude 进程: $pids"
    warn "切换后请关闭当前 Claude Code session,执行 'source ~/.bashrc' 后重启"
  fi
}

# ── 主流程 ──────────────────────────────────────────────────────────────────
ARG="${1:-}"

# 若 .bashrc 还没有 managed 块,自动以 ccr 段初始化(避免第一次 off 时代码失败)
ensure_bashrc_block() {
  if ! grep -qF "$MARKER_BEGIN" "$BASHRC" 2>/dev/null; then
    info ".bashrc 中尚无 managed 块,自动以 ccr 段初始化..."
    local ccr_block
    ccr_block=$(jq -r '.ccr.env | to_entries[] | "export " + .key + "=" + (.value | tostring)' "${PRESETS_FILE}" 2>/dev/null || true)
    {
      echo "$MARKER_BEGIN"
      echo "# 当前模式: ccr-switch 代理(直连用 ccr-switch-off [1/2/3/C])"
      echo "$ccr_block"
      echo "$MARKER_END"
    } >> "$BASHRC"
    ok "已初始化 .bashrc managed 块"
  fi
}
ensure_bashrc_block

case "$ARG" in
  ds|mm|bd)
    info "切换到直连: $ARG"
    block=$(build_direct_block "$ARG" | grep -v "^$" | head -50)
    # build_direct_block 已经 echo 到 stdout,需要捕获
    block=$(build_direct_block "$ARG")
    ;;
  custom)
    list_presets
    block=$(build_custom_block)
    ;;
  "")
    list_presets
    read -r -p "  请选择 [1/2/3/C] 或直接输入别名 (ds/mm/bd/custom): " choice
    case "$choice" in
      1|ds)  block=$(build_direct_block ds) ;;
      2|mm)  block=$(build_direct_block mm) ;;
      3|bd)  block=$(build_direct_block bd) ;;
      c|C|custom) block=$(build_custom_block) ;;
      *) err "无效选择: $choice"; exit 1 ;;
    esac
    ;;
  *)
    err "未知参数: $ARG"
    err "用法: ccr-switch-off [ds|mm|bd|custom]"
    exit 1
    ;;
esac

if [[ -z "$block" ]]; then
  err "未生成 managed 块内容,中止"
  exit 1
fi

write_bashrc_block "$block"
kill_proxy
warn_running_claude

echo ""
ok "已切换到直连模式"
echo -e "  ${CYAN}下一步:${NC}"
echo -e "    1) 关闭当前 Claude Code session"
echo -e "    2) 执行: source ~/.bashrc"
echo -e "    3) 重新启动: claude"
echo ""
echo -e "  ${CYAN}切回代理:${NC} ccr-switch-on"
echo ""
