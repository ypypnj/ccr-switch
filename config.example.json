{
  "_comment": "config.json 模板。运行时配置由 install.sh 使用 ~/.config/ccr-switch/credentials.json 原子生成；api_key 仅保留明确占位符。models 字段必须为对象映射格式。",
  "LOG": true,
  "LOG_LEVEL": "info",
  "API_TIMEOUT_MS": 600000,
  "Providers": [
    {
      "name": "ds",
      "api_base_url": "https://api.deepseek.com/anthropic/v1/messages",
      "api_key": "sk-YOUR_DEEPSEEK_API_KEY",
      "models": {
        "v4pro": "deepseek-v4-pro",
        "v4flash": "deepseek-v4-flash",
        "deepseek-v4-pro": "deepseek-v4-pro",
        "deepseek-v4-flash": "deepseek-v4-flash"
      },
      "transformer": {
        "use": [
          "Anthropic"
        ]
      }
    },
    {
      "name": "mm",
      "api_base_url": "https://api.minimaxi.com/anthropic/v1/messages",
      "api_key": "sk-YOUR_MINIMAX_API_KEY",
      "models": {
        "m3": "MiniMax-M3",
        "MiniMax-M3": "MiniMax-M3"
      },
      "transformer": {
        "use": [
          "Anthropic"
        ]
      }
    },
    {
      "name": "xa",
      "api_base_url": "https://cn.xapex.cc/v1/messages",
      "api_key": "sk-YOUR_XAPEX_API_KEY",
      "models": {
        "gpt5.6": "gpt-5.6-sol",
        "gpt-5.6-sol": "gpt-5.6-sol"
      },
      "transformer": {
        "use": [
          "Anthropic"
        ]
      }
    }
  ],
  "ModelBindings": {
    "claude-haiku-*": "ds,v4flash",
    "claude-sonnet-*": "ds,v4pro",
    "claude-opus-*": "xa,gpt5.6",
    "claude-fable-*": "xa,gpt5.6"
  },
  "Router": {
    "default": "ds,v4pro",
    "background": "ds,v4flash",
    "think": "ds,v4pro",
    "longContext": "ds,v4pro",
    "longContextThreshold": 200000,
    "webSearch": "ds,v4pro",
    "doc": "mm,m3",
    "test": "ds,v4flash",
    "backgroundAlt": "ds,v4flash"
  }
}