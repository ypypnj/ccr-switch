      "name": "ds",
      "api_base_url": "https://api.deepseek.com/anthropic/v1/messages",
      "api_key": "sk-YOUR_DEEPSEEK_API_KEY",
      "models": {
        "v4pro": "deepseek-v4-pro",
        "v4flash": "deepseek-v4-flash",
        "deepseek-v4-pro": "deepseek-v4-pro",
        "deepseek-v4-flash": "deepseek-v4-flash"
      },
      "transformer": {
        "use": [
          "Anthropic"
        ]
      }
    },
    {
      "name": "mm",
      "api_base_url": "https://api.minimaxi.com/anthropic/v1/messages",
      "api_key": "sk-YOUR_MINIMAX_API_KEY",
      "models": {
        "m3": "MiniMax-M3",
        "MiniMax-M3": "MiniMax-M3"
      },
      "transformer": {
        "use": [
          "Anthropic"
        ]
      }
    },
    {
      "name": "bd",
      "api_base_url": "https://qianfan.baidubce.com/anthropic/tokenplan/personal/v1/messages",
      "api_key": "bce-v3-YOUR_BAIDU_QIANFAN_KEY",
      "models": {
        "glm5.2": "glm-5.2",
        "glm-5.2": "glm-5.2",
        "claude-opus-4-8": "glm-5.2",
        "claude-opus-4-7": "glm-5.2",
        "claude-sonnet-5": "glm-5.2",
        "claude-sonnet-4-6": "glm-5.2",
        "claude-haiku-4-5": "glm-5.2"
